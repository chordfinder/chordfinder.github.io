{
  "name": "chordfinder",
  "version": "1.0.0",
  "description": "Browser-based audio chord detection and music visualization",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "npm run build:css",
    "dev:css": "npx @tailwindcss/cli -i ./src/css/input.css -o ./assets/css/style.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./src/css/input.css -o ./assets/css/style.css --minify"
  },
  "keywords": [
    "chords",
    "audio",
    "web-audio-api"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
